    protected override async Task OnInitializedAsync()
    {
        AktivePerson.OnChange += StateHasChanged;
        Wochen = BuildWochen();
        await LadenAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        theme = await JS.InvokeAsync<string?>("themeStore.get");
        dunkelBevorzugt = await JS.InvokeAsync<bool>("themeStore.prefersDark");
        StateHasChanged();

        escRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("escBinder.listen", escRef);
    }

    [JSInvokable]
    public void EscGedrueckt()
    {
        if (selId is null) return;
        selId = null;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        AktivePerson.OnChange -= StateHasChanged;
        toastCts?.Cancel();
        if (escRef is not null)
        {
            try { await JS.InvokeVoidAsync("escBinder.unlisten"); }
            catch (JSDisconnectedException) { /* Verbindung schon weg */ }
            escRef.Dispose();
        }
    }

