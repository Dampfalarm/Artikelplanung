    private List<ArtikelEintrag> GefilterteZeilen()
    {
        if (filter == AnzeigeFilter.Archiv) return eintraege!.Where(e => e.Archiviert).ToList();
        var aktiv = Aktiv;
        return filter switch
        {
            AnzeigeFilter.Offen => aktiv.Where(e => e.Status == ArtikelStatus.Offen).ToList(),
            AnzeigeFilter.InArbeit => aktiv.Where(e => e.Status == ArtikelStatus.InArbeit).ToList(),
            AnzeigeFilter.Angelegt => aktiv.Where(e => e.Status == ArtikelStatus.Angelegt).ToList(),
            _ => aktiv,
        };
    }

    private int Anzahl(AnzeigeFilter f) => f switch
    {
        AnzeigeFilter.Archiv => eintraege!.Count(e => e.Archiviert),
        AnzeigeFilter.Offen => Aktiv.Count(e => e.Status == ArtikelStatus.Offen),
        AnzeigeFilter.InArbeit => Aktiv.Count(e => e.Status == ArtikelStatus.InArbeit),
        AnzeigeFilter.Angelegt => Aktiv.Count(e => e.Status == ArtikelStatus.Angelegt),
        _ => Aktiv.Count,
    };

    private List<WocheInfo> BuildWochen()
    {
        var heute = DateOnly.FromDateTime(DateTime.Now);
        var seitMontag = ((int)heute.DayOfWeek + 6) % 7;
        var montag = heute.AddDays(-seitMontag);
        var liste = new List<WocheInfo>();
        for (var i = 0; i < 8; i++)
        {
            var tag = montag.AddDays(i * 7);
            var (jahr, woche) = KwSchluessel(tag);
            liste.Add(new WocheInfo(jahr, woche, tag.ToString("dd.MM."), i == 0));
        }
        return liste;
    }

    private static int Kw(DateOnly datum) => ISOWeek.GetWeekOfYear(datum.ToDateTime(TimeOnly.MinValue));

    /// <summary>Jahr+Woche als Schlüssel für die Zeitachse: ISOWeek.GetYear (nicht das Kalenderjahr),
    /// weil Anfang Januar/Ende Dezember zur letzten bzw. ersten ISO-Woche des jeweils anderen Jahres
    /// gehören kann. Ohne das Jahr würden Einträge aus verschiedenen Jahren mit derselben KW-Nummer
    /// (z. B. KW 39 in einem Jahr und KW 39 im nächsten) fälschlich in derselben Spalte landen.</summary>
    private static (int Jahr, int Woche) KwSchluessel(DateOnly datum)
    {
        var dt = datum.ToDateTime(TimeOnly.MinValue);
        return (ISOWeek.GetYear(dt), ISOWeek.GetWeekOfYear(dt));
    }

