    private void Flash(string nachricht)
    {
        toast = nachricht;
        toastCts?.Cancel();
        var cts = new CancellationTokenSource();
        toastCts = cts;
        _ = HideToastNachVerzoegerungAsync(cts.Token);
    }

    private async Task HideToastNachVerzoegerungAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(2600, ct);
            toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { /* neuer Toast hat diesen abgelöst */ }
    }

    private async Task StatusAendernAsync(ArtikelEintrag eintrag, ChangeEventArgs e)
    {
        eintrag.Status = Enum.Parse<ArtikelStatus>((string)e.Value!);
        await ArtikelService.UpdateAsync(eintrag);
        await LadenAsync();
    }

    private async Task ReleaseAendernAsync(ArtikelEintrag eintrag, ChangeEventArgs e)
    {
        var text = e.Value as string;
        eintrag.ReleaseDatum = string.IsNullOrEmpty(text) ? null : DateOnly.Parse(text);
        await ArtikelService.UpdateAsync(eintrag);
        await LadenAsync();
    }

    private void OnDraftReleaseGeaendert(ChangeEventArgs e)
    {
