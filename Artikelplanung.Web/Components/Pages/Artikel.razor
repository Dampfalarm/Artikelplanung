@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using Artikelplanung.Web.Models
@using Artikelplanung.Web.Services
@using Artikelplanung.Web.Services.Import
@inject ArtikelService ArtikelService
@inject ArtikelImportService ArtikelImportService
@inject AktivePersonState AktivePerson
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Artikelplanung</PageTitle>

<div class="app">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-mark">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7l9-4 9 4v10l-9 4-9-4z"></path><path d="M3 7l9 4 9-4M12 11v10"></path></svg>
            </span>
            <span style="min-width:0">
                <span class="brand-name" style="display:block">Artikelplanung</span>
                <span class="brand-sub">Neuanlagen</span>
            </span>
            <button type="button" class="theme-toggle" @onclick="ThemeUmschaltenAsync" title="@ThemeTitel">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="@ThemeIconPfad"></path></svg>
            </button>
        </div>

        <nav class="primary-nav">
            <button type="button" class="nav-btn" aria-current="@(ansicht == Ansicht.Neuanlagen ? "page" : null)" @onclick="() => AnsichtWechseln(Ansicht.Neuanlagen)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6h16M4 12h16M4 18h10"></path></svg>
                Neuanlagen
            </button>
            <button type="button" class="nav-btn" aria-current="@(ansicht == Ansicht.Statusspalten ? "page" : null)" @onclick="() => AnsichtWechseln(Ansicht.Statusspalten)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h5v16H4zM10 4h4v11h-4zM15 4h5v7h-5z"></path></svg>
                Statusspalten
            </button>
            <button type="button" class="nav-btn" aria-current="@(ansicht == Ansicht.Zeitachse ? "page" : null)" @onclick="() => AnsichtWechseln(Ansicht.Zeitachse)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 5h18v16H3zM3 10h18M8 3v4M16 3v4"></path></svg>
                Zeitachse
            </button>
        </nav>

        <div class="sidebar-foot">
            <div>Eingetragen als <strong>@(AktivePerson.Name ?? "niemand")</strong></div>
            <button type="button" class="btn tiny" @onclick="() => AktivePerson.Zuruecksetzen()">Person wechseln</button>
            <div>Nur im Firmennetz · kein Login</div>
        </div>
    </aside>

    <main>
        <div class="view" style="max-width:1920px;margin:0 auto;width:100%">

            <div class="page-head">
                <div>
                    <h1>@Titel</h1>
                    <p>@Untertitel</p>
                </div>
                <button type="button" class="btn primary" style="padding:12px 21px;font-size:18.75px;gap:9px" @onclick="() => neuOffen = !neuOffen">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg>
                    Neuer Artikel
                </button>
            </div>

            @if (neuOffen)
            {
                <div class="panel">
                    <div class="panel-head">
                        <h2>Neuer Artikel</h2>
                    </div>
                    <div class="info-note" style="margin-bottom:14px">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-5M12 8h.01"></path></svg>
                        <span>Ein Eintrag ist ein Anlage-Vorhaben — eine Herstellerliste mit acht Sorten bleibt ein Eintrag.</span>
                    </div>

                    <div class="field-row">
                        <span class="lbl">Shop</span>
                        <div>
                            <div class="seg">
                                @foreach (var m in Enum.GetValues<Marke>())
                                {
                                    <button type="button" class="@(neu.Marke == m ? "on" : "")" @onclick="() => neu.Marke = m">@m</button>
                                }
                            </div>
                            <div class="desc">Für welchen Shop der Artikel angelegt werden muss.</div>
                        </div>
                    </div>

                    <div class="field-row">
                        <span class="lbl">Artikelname</span>
                        <div>
                            <input type="text" @bind="neu.Artikelname" @bind:event="oninput" placeholder="z. B. SIC Longfill Serie" style="width:100%;max-width:460px" />
                        </div>
                    </div>

                    <div class="field-row">
                        <span class="lbl">Priorität</span>
                        <div>
                            <div class="seg">
                                @foreach (var p in Enum.GetValues<Prioritaet>())
                                {
                                    <button type="button" class="@(neu.Prioritaet == p ? "on" : "")" @onclick="() => neu.Prioritaet = p">@Label(p)</button>
                                }
                            </div>
                            <div class="desc">Standard ist Niedrig.</div>
                        </div>
                    </div>

                    <div class="field-row">
                        <span class="lbl">Release-Datum</span>
                        <div>
                            <input type="date" value="@(neu.ReleaseDatum?.ToString("yyyy-MM-dd"))" @onchange="OnDraftReleaseGeaendert" />
                            <div class="desc">Optional — ohne Datum steht der Eintrag im Backlog der Zeitachse.</div>
                        </div>
                    </div>

                    <div class="field-row">
                        <span class="lbl">Notiz</span>
                        <div>
                            <textarea @bind="neu.Notiz" @bind:event="oninput" placeholder="Worauf es bei dieser Anlage ankommt" style="max-width:560px"></textarea>
                        </div>
                    </div>

                    <div class="field-row">
                        <span class="lbl">Excel-Liste</span>
                        <div>
                            <div class="filter-bar" style="align-items:center">
                                <label class="btn" style="position:relative;overflow:hidden">
                                    Datei wählen (.xlsx)
                                    <InputFile OnChange="NeueImportDateiAusgewaeltAsync" accept=".xlsx" style="position:absolute;inset:0;opacity:0;cursor:pointer" />
                                </label>
                                <span class="chip">@(neuImportDateiname is not null ? $"{neuImportDateiname} · {neuImportTabelle!.Rows.Count} Zeilen erkannt" : "keine Datei gewählt")</span>
                            </div>
                            @if (neuImportFehler is not null)
                            {
                                <div class="error-note" style="margin-top:8px">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-5M12 8h.01"></path></svg>
                                    <span>@neuImportFehler</span>
                                </div>
                            }
                            <div class="desc">Wird unverändert an diesen einen Eintrag gehängt, nicht in Zeilen zerlegt.</div>
                        </div>
                    </div>

                    <div class="filter-bar" style="align-items:center;margin-top:16px">
                        <button type="button" class="btn primary" @onclick="AnlegenAsync" disabled="@AnlegenGesperrt">Anlegen</button>
                        <button type="button" class="btn ghost" @onclick="() => neuOffen = false">Abbrechen</button>
                        <span class="hint">@AnlegenHinweis</span>
                    </div>
                </div>
            }

            @if (eintraege is null)
            {
                <p class="hint">Lädt…</p>
            }
            else if (ansicht == Ansicht.Neuanlagen)
            {
                <div class="view">
                    <div class="filter-bar">
                        <div class="seg">
                            @foreach (var f in Enum.GetValues<AnzeigeFilter>())
                            {
                                <button type="button" class="@(filter == f ? "on" : "")" @onclick="() => filter = f">@Label(f)<span class="cnt">@Anzahl(f)</span></button>
                            }
                        </div>
                        @if (ArchivierbarAnzahl > 0)
                        {
                            <button type="button" class="btn" @onclick="AlleArchivierenAsync">Angelegte ins Archiv (@ArchivierbarAnzahl)</button>
                        }
                    </div>

                    <div class="table-wrap">
                        <table style="min-width:1040px">
                            <thead>
                                <tr>
                                    <th style="width:104px">Priorität</th>
                                    <th style="width:66px">Shop</th>
                                    <th>Artikel</th>
                                    <th style="width:116px">Release</th>
                                    <th style="width:148px">Status</th>
                                    <th style="width:104px">Eingetragen</th>
                                    <th style="width:150px">Anhang</th>
                                    <th style="width:116px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var zeilen = GefilterteZeilen(); }
                                @foreach (var eintrag in zeilen)
                                {
                                    <tr style="cursor:pointer" @onclick="() => selId = eintrag.Id">
                                        <td><PrioBadge Prioritaet="eintrag.Prioritaet" /></td>
                                        <td><ShopChip Marke="eintrag.Marke" /></td>
                                        <td class="supplier-cell">
                                            <div class="alias">@eintrag.Artikelname</div>
                                            <div class="real">@Nr(eintrag.Id)</div>
                                        </td>
                                        <td class="num">@Fmt(eintrag.ReleaseDatum)</td>
                                        <td>
                                            <select value="@eintrag.Status" @onclick:stopPropagation @onchange:stopPropagation @onchange="e => StatusAendernAsync(eintrag, e)" style="font-size:12px;padding:5px 8px">
                                                @foreach (var s in Enum.GetValues<ArtikelStatus>())
                                                {
                                                    <option value="@s">@Label(s)</option>
                                                }
                                            </select>
                                        </td>
                                        <td>@eintrag.EingetragenVon</td>
                                        <td>
                                            @if (eintrag.Quelle is not null)
                                            {
                                                <span class="chip" title="@AnhangTitel(eintrag)">@eintrag.Quelle</span>
                                            }
                                            else
                                            {
                                                <span class="hint" title="keine Liste angehängt">–</span>
                                            }
                                        </td>
                                        <td>
                                            <button type="button" class="btn tiny" @onclick:stopPropagation @onclick="() => ArchivWechselnAsync(eintrag)">@(eintrag.Archiviert ? "Zurückholen" : "Archivieren")</button>
                                        </td>
                                    </tr>
                                }
                                @if (zeilen.Count == 0)
                                {
                                    <tr class="empty-row"><td colspan="8">@(filter == AnzeigeFilter.Archiv ? "Noch nichts archiviert." : "Nichts in diesem Filter.")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="info-note">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-5M12 8h.01"></path></svg>
                        <span>Zeile anklicken öffnet den Artikel mit Notiz und angehängter Herstellerliste. Angelegte Artikel wanderst du ins Archiv, damit die Liste kurz bleibt — gelöscht wird nichts.</span>
                    </div>
                </div>
            }
            else if (ansicht == Ansicht.Statusspalten)
            {
                <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:start">
                    @foreach (var status in StatusReihenfolge)
                    {
                        var items = Aktiv.Where(e => e.Status == status).ToList();
                        <div class="panel" style="padding:18px 0 4px">
                            <div class="panel-head" style="padding:0 20px">
                                <h2>@Label(status)</h2>
                                <span class="count">@items.Count</span>
                            </div>
                            <table>
                                <tbody>
                                    @foreach (var eintrag in items)
                                    {
                                        <tr style="cursor:pointer" @onclick="() => selId = eintrag.Id">
                                            <td class="supplier-cell">
                                                <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:5px">
                                                    <PrioBadge Prioritaet="eintrag.Prioritaet" />
                                                    <ShopChip Marke="eintrag.Marke" />
                                                </div>
                                                <div class="alias">@eintrag.Artikelname</div>
                                                <div class="real">@eintrag.EingetragenVon · @(eintrag.ReleaseDatum is { } d ? Fmt(d) : "kein Termin")</div>
                                            </td>
                                        </tr>
                                    }
                                    @if (items.Count == 0)
                                    {
                                        <tr class="empty-row"><td>Nichts in diesem Zustand.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="view">
                    <div class="table-wrap">
                        <div style="display:grid;grid-template-columns:148px repeat(8,minmax(126px,1fr));min-width:1156px;background:var(--surface-raised);border-bottom:1px solid var(--line)">
                            <span style="padding:10px 12px;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-faint);font-weight:600">Priorität</span>
                            @foreach (var w in Wochen)
                            {
                                <span style="display:flex;flex-direction:column;gap:1px;padding:10px 12px;border-left:1px solid var(--line);color:@(w.IstAktuelleWoche ? "var(--accent-ink)" : "var(--ink-faint)");background:@(w.IstAktuelleWoche ? "var(--accent-soft)" : "transparent")">
                                    <span style="font-size:11px;text-transform:uppercase;letter-spacing:.04em;font-weight:600">KW @w.Nr</span>
                                    <span class="mono" style="font-size:11px;color:var(--ink-faint)">@w.StartLabel</span>
                                </span>
                            }
                        </div>
                        @foreach (var p in new[] { Prioritaet.Hoch, Prioritaet.Mittel, Prioritaet.Niedrig })
                        {
                            <div style="display:grid;grid-template-columns:148px repeat(8,minmax(126px,1fr));min-width:1156px;border-bottom:1px solid var(--line)">
                                <span style="padding:12px;display:flex;align-items:flex-start"><PrioBadge Prioritaet="p" /></span>
                                @foreach (var w in Wochen)
                                {
                                    <span style="display:flex;flex-direction:column;gap:6px;padding:8px;border-left:1px solid var(--line);background:@(w.IstAktuelleWoche ? "var(--accent-soft)" : "transparent")">
                                        @foreach (var eintrag in Aktiv.Where(e => e.Prioritaet == p && e.ReleaseDatum.HasValue && KwSchluessel(e.ReleaseDatum!.Value) == (w.Jahr, w.Nr)))
                                        {
                                            <button type="button" @onclick="() => selId = eintrag.Id" style="display:flex;flex-direction:column;gap:2px;text-align:left;cursor:pointer;padding:7px 9px;background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--radius-s);color:var(--ink);font:inherit;width:100%">
                                                <span style="font-size:12.5px;font-weight:500;line-height:1.3">@eintrag.Artikelname</span>
                                                <span class="mono" style="font-size:10.5px;color:var(--ink-faint)">@(eintrag.Marke == Marke.Dartalarm ? "DT" : "DA") · @eintrag.EingetragenVon</span>
                                            </button>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="panel" style="padding:18px 0 4px">
                        <div class="panel-head" style="padding:0 20px">
                            <h2>Ohne Release-Datum</h2>
                            <span class="count">@(OhneDatum.Count) Einträge warten auf einen Termin</span>
                        </div>
                        <table>
                            <tbody>
                                @foreach (var eintrag in OhneDatum)
                                {
                                    <tr style="cursor:pointer" @onclick="() => selId = eintrag.Id">
                                        <td style="width:1%;padding-right:0"><PrioBadge Prioritaet="eintrag.Prioritaet" /></td>
                                        <td style="width:1%"><ShopChip Marke="eintrag.Marke" /></td>
                                        <td class="supplier-cell">
                                            <div class="alias">@eintrag.Artikelname</div>
                                            <div class="real">@Nr(eintrag.Id) · @eintrag.EingetragenVon</div>
                                        </td>
                                        <td style="text-align:right">@Label(eintrag.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </main>
</div>

@if (SelEintrag is { } sel)
{
    <div class="detail">
        <div class="detail-head">
            <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;min-width:0">
                <h2 class="mono" style="font-size:18px">@Nr(sel.Id)</h2>
                <span style="font-size:15.5px;font-weight:600">@sel.Artikelname</span>
                <ShopChip Marke="sel.Marke" />
                <PrioBadge Prioritaet="sel.Prioritaet" />
            </div>
            <button type="button" class="btn" @onclick="() => selId = null">Schließen <span class="mono" style="opacity:.6">Esc</span></button>
        </div>

        <div class="detail-body">
            <div class="detail-info">
                <div class="panel">
                    <div class="kv-grid">
                        <div class="kv">
                            <div class="k">Status</div>
                            <div class="v">
                                <select value="@sel.Status" @onchange="e => StatusAendernAsync(sel, e)" style="width:100%">
                                    @foreach (var s in Enum.GetValues<ArtikelStatus>())
                                    {
                                        <option value="@s">@Label(s)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="kv">
                            <div class="k">Release-Datum</div>
                            <div class="v"><input type="date" value="@(sel.ReleaseDatum?.ToString("yyyy-MM-dd"))" @onchange="e => ReleaseAendernAsync(sel, e)" style="width:100%" /></div>
                        </div>
                        <div class="kv">
                            <div class="k">Eingetragen von</div>
                            <div class="v">@sel.EingetragenVon</div>
                        </div>
                        <div class="kv">
                            <div class="k">Angelegt am</div>
                            <div class="v mono">@sel.ErstelltAm.ToString("dd.MM.yyyy")</div>
                        </div>
                        <div class="kv">
                            <div class="k">Shop</div>
                            <div class="v">@sel.Marke</div>
                        </div>
                        <div class="kv">
                            <div class="k">Kalenderwoche</div>
                            <div class="v mono">@(sel.ReleaseDatum is { } kwd ? $"KW {Kw(kwd)}" : "—")</div>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-head">
                        <h2>Notiz</h2>
                    </div>
                    <div class="text-preview">@(string.IsNullOrWhiteSpace(sel.Notiz) ? "Keine Notiz hinterlegt." : sel.Notiz)</div>
                </div>

                <div class="filter-bar" style="margin-top:auto;padding-top:10px;border-top:1px dashed var(--line)">
                    <button type="button" class="btn" @onclick="() => ArchivWechselnAsync(sel)">@(sel.Archiviert ? "Zurückholen" : "Ins Archiv")</button>
                    <button type="button" class="btn danger" @onclick="() => LoeschenAsync(sel)">Löschen</button>
                </div>
            </div>

            <div class="doc-pane">
                <div style="flex:none;display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:9px 12px;background:var(--surface-raised);border-bottom:1px solid var(--line)">
                    <span class="mono" style="font-size:11.5px;color:var(--ink-soft)">@(sel.Quelle ?? "kein Anhang")</span>
                    <span class="chip">@AnhangInfo(sel)</span>
                    <label class="btn tiny" style="position:relative;overflow:hidden;margin-left:auto">
                        @(sel.ImportTabelleJson is not null ? "Andere Datei anhängen" : "Datei wählen")
                        <InputFile OnChange="e => AnhaengenAsync(sel.Id, e)" accept=".xlsx" style="position:absolute;inset:0;opacity:0;cursor:pointer" />
                    </label>
                </div>

                @if (anhaengenFehler is { } fehler && fehler.ArtikelId == sel.Id)
                {
                    <div class="error-note" style="margin:8px 12px 0">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"></circle><path d="M12 16v-5M12 8h.01"></path></svg>
                        <span>@fehler.Meldung</span>
                    </div>
                }

                @if (sel.ImportTabelleJson is { } json)
                {
                    var tabelle = SpreadsheetTable.FromJson(json);
                    <div style="flex:1;min-height:0;overflow:auto">
                        <table style="min-width:100%">
                            <thead>
                                <tr>
                                    @foreach (var h in tabelle.Headers)
                                    {
                                        <th style="white-space:nowrap">@h</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var zeile in tabelle.Rows)
                                {
                                    <tr>
                                        @for (var i = 0; i < tabelle.Headers.Count; i++)
                                        {
                                            <td style="white-space:nowrap">@(i < zeile.Count ? zeile[i] : null)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:44px 20px;text-align:center;color:var(--ink-faint);font-size:12.5px">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5"></path></svg>
                        <strong style="color:var(--ink-soft);font-weight:600">Noch keine Herstellerliste angehängt</strong>
                        <span>Eine .xlsx wird unverändert an diesen Eintrag gehängt — Kopfzeile und alle Zeilen, ohne festes Spaltenschema.</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

<PersonenAuswahl OnAusgewaehlt="OnPersonAusgewaehltAsync" />

@if (toast is not null)
{
    <div class="panel" style="position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:70;display:flex;align-items:center;gap:10px;padding:11px 16px;border-radius:var(--radius-s);box-shadow:var(--shadow);font-size:12.5px">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.8"><path d="M20 6L9 17l-5-5"></path></svg>
        @toast
    </div>
}

@code {
    private enum Ansicht { Neuanlagen, Statusspalten, Zeitachse }
    private enum AnzeigeFilter { Alle, Offen, InArbeit, Angelegt, Archiv }
    private record WocheInfo(int Jahr, int Nr, string StartLabel, bool IstAktuelleWoche);

    private static readonly ArtikelStatus[] StatusReihenfolge =
        [ArtikelStatus.Offen, ArtikelStatus.InArbeit, ArtikelStatus.Angelegt];

    private List<ArtikelEintrag>? eintraege;
    private Ansicht ansicht = Ansicht.Neuanlagen;
    private AnzeigeFilter filter = AnzeigeFilter.Alle;
    private int? selId;
    private bool neuOffen;
    private NeuerEintragModel neu = new();
    private string? neuImportDateiname;
    private SpreadsheetTable? neuImportTabelle;
    private string? neuImportFehler;
    private (int ArtikelId, string Meldung)? anhaengenFehler;
    private string? toast;
    private CancellationTokenSource? toastCts;
    private List<WocheInfo> Wochen { get; set; } = [];
    private string? theme;
    private bool dunkelBevorzugt;
    private DotNetObjectReference<Artikel>? escRef;

    private List<ArtikelEintrag> Aktiv => eintraege!.Where(e => !e.Archiviert).ToList();
