    private async Task ArchivWechselnAsync(ArtikelEintrag eintrag)
    {
        var neuerWert = !eintrag.Archiviert;
        await ArtikelService.SetArchiviertAsync(eintrag.Id, neuerWert);
        selId = null;
        var name = eintrag.Artikelname;
